# Node.js 24.x. Copy this file to .env.local if you need overrides.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=var/hrstudio.sqlite

# Neon backend (server only). Copy the pooled connection URL from Connect.
# Use a percent-encoded database password; never use a VITE_ prefix.
DATABASE_URL=
# Optional direct URL for the one-time setup command; never used by API requests.
DATABASE_URL_UNPOOLED=
# Optional custom root certificate; normally leave blank for Neon.
DATABASE_CA=
# Compatibility for older Supabase deployments (ignored when DATABASE_URL is set).
SUPABASE_DB_URL=
SUPABASE_DB_CA=

# For an HTTPS deployment, set the exact public origin and close registration
# after creating the intended companies. Secure cookies default to true in production.
APP_URL=
REGISTRATION_OPEN=true
# Optional sample-only login buttons. First run npm run demo:populate.
DEMO_LOGIN_ENABLED=false
# Hosted startup only: create fictional samples on an empty database.
# Requires DEMO_LOGIN_ENABLED=true. See DEPLOYMENT.md for persistent hosting.
DEMO_BOOTSTRAP=false
# Local HTTP production smoke test only: COOKIE_SECURE=false
# Keep COOKIE_SECURE=true for an HTTPS deployment.

# Optional mail delivery. Nothing is sent if these are unset.
# For Zoho Mail (India): SMTP_HOST=smtppro.zoho.in, SMTP_PORT=465, IMAP_HOST=imappro.zoho.in, IMAP_PORT=993
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true

# Optional automatic CC recipients for all outgoing notification emails
CC_DIRECTOR_EMAIL=
CC_ACCOUNTS_EMAIL=

# Comma-separated admin email IDs automatically provisioned / granted HR access
ADMIN_EMAILS=

# Optional candidate evaluation & mass email drafting; resumes are sent only on an explicit review action.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

